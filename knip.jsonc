{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs", "playwright.config.js", "tests/**/*.{js,mjs}"],
  "project": ["scripts/**/*.mjs", "playwright.config.js", "tests/**/*.{js,mjs}"],
  "ignore": ["nuxt/**", "drupal/**"],
  // `serve` is spawned by Playwright's `webServer` command, which is a string
  // knip cannot follow. Removing it would break every browser test.
  // `sharp` is resolved out of `nuxt/node_modules` on purpose: it is a native
  // binary that `@nuxt/image` already installs, and listing it at the root
  // would put it in every consumer's install for one script.
  "ignoreDependencies": ["serve", "sharp"],
}
