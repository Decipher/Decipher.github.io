#!/usr/bin/env php
<?php

/**
 * @file
 * Provision the site: install a throwaway SQLite database directly from
 * the committed config (adopting its site UUID), import Tome-tracked
 * content and files.
 *
 * The sign-in pieces are committed: simple_oauth and consumers are in the
 * config, the `authoring` scope is config, and the frontend's Consumer is
 * Tome content. Only the OAuth key pair is made here, because a private key
 * is never committed. `.devtools/provision-authoring` then adds what is per
 * backend: the frontend origin's CORS rules, the trusted hosts and the
 * session's own callback URL.
 *
 * `drush site-install --existing-config` installs straight from the
 * committed config, adopting its site UUID. A plain `tome:install` does
 * a fresh `site-install` then a *separate* `config:import`, which fails
 * ("Site UUID in source storage does not match the target storage")
 * because the fresh install already generated its own random UUID
 * before the import ever runs - `--existing-config` avoids that by
 * adopting the config's UUID as part of the same install step.
 *
 * The committed config is authored against DDEV's MySQL (`mysql: 0` in
 * `config/core.extension.yml`), and Drupal refuses to uninstall the
 * module providing its own active DB driver - so this patches the
 * enabled module list to also enable `sqlite`, additively (never
 * removing `mysql`) and only in this checkout, never committed. Same
 * pattern `docs/drupal`'s `.devtools/provision` uses.
 */

declare(strict_types=1);

namespace DecipheredDevTools;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------
// Variables.
// -----------------------------------------------------------------------------

$db_file = resolve_env_value('DB_FILE', default_db_file())[0];

// -----------------------------------------------------------------------------

echo '===============================' . PHP_EOL;
echo '         🚀 PROVISION          ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;

TASK('Enabling the sqlite module in this checkout only (never committed).');
$extension_yml = 'config/core.extension.yml';
$content = (string) file_get_contents($extension_yml);
if (!str_contains($content, "\n  sqlite:")) {
  $anchor = "  mysql: 0\n";
  if (!str_contains($content, $anchor)) {
    FAIL('Could not find the expected anchor ("%s") in %s to patch in the sqlite module. The module list may have changed shape - update this script\'s anchor rather than skipping the patch.', trim($anchor), $extension_yml);
  }
  $content = str_replace($anchor, $anchor . "  sqlite: 0\n", $content);
  file_put_contents($extension_yml, $content);
}
PASS('sqlite module enabled for this checkout.');

TASK('Preparing web/sites/default/settings.php.');
$settings_php = 'web/sites/default/settings.php';
$settings_contents = (string) file_get_contents($settings_php);
$commented_include = "#\n# if (file_exists(\$app_root . '/' . \$site_path . '/settings.local.php')) {\n#   include \$app_root . '/' . \$site_path . '/settings.local.php';\n# }\n";
$active_include = "\nif (file_exists(\$app_root . '/' . \$site_path . '/settings.local.php')) {\n  include \$app_root . '/' . \$site_path . '/settings.local.php';\n}\n";
if (str_contains($settings_contents, $commented_include)) {
  file_put_contents($settings_php, str_replace($commented_include, $active_include, $settings_contents));
}
elseif (!str_contains($settings_contents, $active_include)) {
  FAIL('Could not find the expected settings.local.php include block (commented or active) in %s. The file may have changed shape - update this script\'s anchor rather than skipping the patch.', $settings_php);
}
PASS('settings.php includes settings.local.php.');

TASK('Configuring the SQLite database at %s.', $db_file);
if (file_exists($db_file)) {
  unlink($db_file);
}
// var_export() so a path containing quotes stays valid PHP.
$db_file_php = var_export($db_file, TRUE);
file_put_contents('web/sites/default/settings.local.php', sprintf(
  "<?php\n\n/**\n * @file\n * Provision-only override, written fresh each run by .devtools/provision.\n * Gitignored - never committed.\n */\n\n\$databases['default']['default'] = [\n  'driver' => 'sqlite',\n  'database' => %s,\n];\n\n// Here rather than in settings.php, which is tracked. `site-install` writes the\n// salt there, so any `git checkout` of that file silently empties it and every\n// request afterwards is a 500 that names a setting rather than the checkout.\n\$settings['hash_salt'] = %s;\n",
  $db_file_php,
  var_export(bin2hex(random_bytes(32)), TRUE)
));
PASS('SQLite database configured.');

// This site is reached through a tunnel that terminates TLS and forwards plain
// HTTP to here. Without being told, Drupal builds absolute URLs from the
// request it actually received, so the JSON:API index advertises http:// links.
// The frontend is served over https, so the browser blocks every one of those
// as mixed content: the site connects, fetches nothing, and renders a blank
// page with no error a reader could act on.
TASK('Trusting the tunnel that terminates TLS in front of this.');
file_put_contents(
  'web/sites/default/settings.local.php',
  "\n\$settings['reverse_proxy'] = TRUE;\n"
    . "\$settings['reverse_proxy_addresses'] = ['127.0.0.1', '::1'];\n",
  FILE_APPEND
);
PASS('Forwarded scheme and host will be honoured.');

// Where the vale module finds its binary and rules: the pinned install from
// .devtools/assemble, and the committed .vale.ini beside the web root.
TASK('Pointing the vale module at its binary and rules.');
file_put_contents(
  'web/sites/default/settings.local.php',
  "\n\$settings['vale_binary'] = \$app_root . '/../bin/vale';\n"
    . "\$settings['vale_config'] = \$app_root . '/../.vale.ini';\n",
  FILE_APPEND
);
PASS('Vale settings written.');

// The authoring provisioner writes its CORS settings to their own file and
// registers it here. This script rewrites this file from scratch, so a plain
// re-provision drops that registration and takes cross-origin authoring with
// it: reads keep working, because a GET with no custom header needs no
// preflight, and anything that does need one starts failing with nothing in
// the log to say why. Uploading an image was broken this way for a day.
//
// So re-register it whenever the file is there, rather than leaving it to
// whoever remembers to run the other script afterwards.
TASK('Registering authoring CORS settings, if they exist.');
if (file_exists('web/sites/default/authoring.services.yml')) {
  file_put_contents(
    'web/sites/default/settings.local.php',
    "\n// Authoring: CORS for the deployed frontend's origin.\n"
      . "\$settings['container_yamls'][] = \$app_root . '/' . \$site_path . '/authoring.services.yml';\n",
    FILE_APPEND
  );
  PASS('authoring.services.yml registered.');
}
else {
  PASS('None found; run .devtools/provision-authoring to create them.');
}

TASK('Running drush site-install --existing-config.');
drush('site-install --existing-config');
PASS('Site installed from committed config.');

TASK('Making the OAuth key pair, if this checkout has none.');
ensure_oauth_keys(getcwd() . '/keys');

TASK('Importing Tome-tracked content and files.');
drush('tome:import');
PASS('Content and files imported.');

// The frontend can only sign in if these three things came through the
// install and the import. Each of them was missing once, and each failure
// showed up only as a failed login on the frontend, so check here instead.
TASK('Checking that the frontend can sign in against this backend.');
$client_id = committed_consumer_id();
drush('php-eval %s', str_replace('__CLIENT_ID__', $client_id, <<<'PHP'
$client_id = "__CLIENT_ID__";
$consumers = \Drupal::entityTypeManager()->getStorage("consumer")->loadByProperties(["client_id" => $client_id]);
if (count($consumers) !== 1) {
  throw new \RuntimeException(sprintf("Expected one Consumer with client_id %s, found %d. Is drupal/content/consumer.%s.json committed and in content/meta/index.json?", $client_id, count($consumers), $client_id));
}
$consumer = reset($consumers);
$scopes = array_column($consumer->get("authorization_code_scopes")->getValue(), "scope_id");
if (!\Drupal::entityTypeManager()->getStorage("oauth2_scope")->load("authoring") || !in_array("authoring", $scopes, TRUE)) {
  throw new \RuntimeException("The Consumer has no default `authoring` scope, so every authorize request would be refused.");
}
$settings = \Drupal::config("simple_oauth.settings");
foreach (["public_key", "private_key"] as $key) {
  $path = DRUPAL_ROOT . "/" . $settings->get($key);
  if (!is_file($path)) {
    throw new \RuntimeException(sprintf("simple_oauth.settings %s points at %s, which does not exist.", $key, $path));
  }
}
// A token's permissions are the scope's roles that the account also holds,
// so a scope that grants only `authenticated` signs an editor in to a site
// they cannot edit. The scope has to grant the roles that edit.
$scope_provider = \Drupal::service("simple_oauth.oauth2_scope.provider");
$granted = $scope_provider->getRoles($scope_provider->load("authoring"));
foreach (["content_editor", "administrator"] as $role) {
  if (!in_array($role, $granted, TRUE)) {
    throw new \RuntimeException(sprintf("The `authoring` scope grants the roles [%s], not %s, so that account's token could not edit.", implode(", ", $granted), $role));
  }
}
// And the editor role has to be able to edit what this site is made of.
$editor = \Drupal\user\Entity\Role::load("content_editor");
foreach (["create slide content", "edit any slide content"] as $permission) {
  if (!$editor->hasPermission($permission)) {
    throw new \RuntimeException(sprintf("The content_editor role lacks `%s`, so an editor's token could sign in but not edit a slide.", $permission));
  }
}
PHP));
PASS('Consumer %s, the authoring scope with its editor role, and the key pair are all in place.', $client_id);

echo PHP_EOL;
echo '===============================' . PHP_EOL;
echo '   🚀 PROVISION COMPLETE  ✅  ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;
echo 'Database: ' . $db_file . PHP_EOL;
echo PHP_EOL;
echo '> Next steps:' . PHP_EOL;
echo '  .devtools/start    # Start the webserver' . PHP_EOL;
echo PHP_EOL;
