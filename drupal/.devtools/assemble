#!/usr/bin/env php
<?php

/**
 * @file
 * Assemble the site codebase.
 *
 * This repo already IS the site codebase — there is no `composer
 * create-project` scaffolding step to do. This just installs dependencies.
 */

declare(strict_types=1);

namespace DecipheredDevTools;

require_once __DIR__ . '/helpers.php';

echo '===============================' . PHP_EOL;
echo '         ASSEMBLE              ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;

TASK('Validating tools.');
command_must_exist('composer');
PASS('Tools are valid.');

TASK('Installing Composer dependencies.');
putenv('COMPOSER_MEMORY_LIMIT=-1');
passthru_with_retries('composer install --no-interaction --no-progress');
PASS('Dependencies installed.');

// Checked, not trusted. A patch that does not apply fails the first install;
// the retry then finds every package already installed, so Composer Patches
// never runs and the retry succeeds with packages unpatched. A stale
// patches.lock.json surfaced that way as a tome:import failure much later,
// with nothing pointing back here.
TASK('Checking that every patch in patches.lock.json is applied.');
$unapplied = unapplied_patches();
if ($unapplied) {
  foreach ($unapplied as $line) {
    FAIL_NO_EXIT('Not applied: %s', $line);
  }
  FAIL('If composer.json and patches.lock.json list different patches, run `composer patches-relock`, then `composer install` again.');
}
PASS('Every patch is applied.');

echo PHP_EOL;
echo '===============================' . PHP_EOL;
echo '    ASSEMBLE COMPLETE          ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;
echo '> Next steps:' . PHP_EOL;
echo '  .devtools/provision    # Install the site (SQLite + committed Tome config/content)' . PHP_EOL;
echo '  .devtools/start        # Start the webserver' . PHP_EOL;
echo PHP_EOL;
