# Ignore directories generated by Composer
bin/
drush/contrib/
keys/*.key
vendor/
web/core/
web/modules/contrib/
web/themes/contrib/
web/profiles/contrib/
web/libraries/

# Ignore sensitive information
web/sites/*/settings.local.php

# Ignore Drupal's file directory
web/sites/*/files/
!web/sites/default/files/.gitkeep

# Ignore SimpleTest multi-site environment.
web/sites/simpletest

# Ignore environment specific files.
.env
web/robots.txt
.editorconfig
.gitattributes
.ddev/docker-compose.host-docker-internal.yaml

# Authoring session artefacts, written by .devtools/provision-authoring.
web/sites/*/authoring.services.yml

# Tome exports content entities as they are saved, and an OAuth token is one,
# so a sign-in writes its token value into content/. This repository is public.
# .devtools/session-export deletes these; ignoring them as well means a stray
# `tome:export` outside that flow cannot commit one either.
content/oauth2_token.*.json
.devtools/.session-infra
keys/
