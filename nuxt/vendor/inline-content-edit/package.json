{
  "name": "@druxt-contrib/inline-content-edit",
  "version": "0.0.0",
  "description": "Stages edits in the browser, previews them in place and sends them on when a backend exists.",
  "keywords": [
    "druxt",
    "nuxt",
    "drupal",
    "jsonapi",
    "authoring",
    "decoupled"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "require": "./dist/index.ssr.js",
      "import": "./dist/index.esm.js"
    },
    "./components/*": "./dist/components/*"
  },
  "main": "dist/index.ssr.js",
  "module": "dist/index.esm.js",
  "files": [
    "dist",
    "templates"
  ],
  "peerDependencies": {
    "druxt-auth": "^0.5.0",
    "vue": "^2.7.0"
  },
  "peerDependenciesMeta": {
    "druxt-auth": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.20.1"
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml"
  }
}
