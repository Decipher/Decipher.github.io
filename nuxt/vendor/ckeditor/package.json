{
  "name": "@druxt-contrib/ckeditor",
  "version": "0.0.0",
  "description": "Mounts the CKEditor 5 build Drupal ships in a Druxt frontend.",
  "keywords": [
    "druxt",
    "nuxt",
    "ckeditor",
    "drupal"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "require": "./dist/index.ssr.js",
      "import": "./dist/index.esm.js"
    },
    "./components/*": "./dist/components/*"
  },
  "main": "dist/index.ssr.js",
  "module": "dist/index.esm.js",
  "files": [
    "dist",
    "templates"
  ],
  "peerDependencies": {
    "druxt": "^0.21.0"
  },
  "engines": {
    "node": ">=16.20.1"
  }
}
